# ==============================================================================
# CONFIGURACIÓN DEL PROYECTO (Copia este archivo a .env)
# ==============================================================================

# Nombre del proyecto
PROJECT_NAME="FastAPI Scaffold"

# Entorno: DEV, STAGING, PROD
ENVIRONMENT=DEV

# ── Base de Datos ─────────────────────────────────────────────────────────────
# Por defecto SQLite local para desarrollo rápido sin dependencias.
# En producción o PostgreSQL remoto (ej. Neon / Railway / Supabase):
# postgresql://user:password@host:port/dbname
DATABASE_URL="sqlite:///./dev.db"

# Imprimir queries SQL en consola (True para depurar queries en local)
SQL_ECHO=False

# ── CORS ──────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por comas
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ── Copernicus Data Space Ecosystem (CDSE - Datos de la Tierra) ──────────────
# STAC API URL (Búsquedas públicas y metadatos)
CDSE_STAC_API_URL="https://stac.dataspace.copernicus.eu/v1"

# Credenciales CDSE (Para descargar datos completos u obtener límites altos)
# Registro gratuito en: https://dataspace.copernicus.eu/
CDSE_USERNAME=""
CDSE_PASSWORD=""
CDSE_TOKEN_URL="https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token"
CDSE_CLIENT_ID="cdse-public"
