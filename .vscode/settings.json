{
  "python.defaultInterpreterPath": "${workspaceFolder}/server/venv/Scripts/python.exe",
  "python.useEnvironmentsExtension": false,
  "python.locator": "js",
  "python.venvPath": "${workspaceFolder}/server",
  "python.terminal.activateEnvironment": true,
  "python.analysis.extraPaths": [
    "${workspaceFolder}/server"
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/server",
  "python.testing.pytestPath": "${workspaceFolder}/server/venv/Scripts/pytest.exe",
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python-envs.workspaceSearchPaths": [
    "./server/venv",
    "./**/.venv"
  ]
}
